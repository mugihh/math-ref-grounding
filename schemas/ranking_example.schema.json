{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathref.local/schemas/ranking_example.schema.json",
  "title": "Mention-to-box ranking example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "frame_id",
    "language",
    "topic",
    "video",
    "image_path",
    "image_size",
    "caption",
    "mention",
    "gold_visual_ids",
    "gold_object_types",
    "candidates"
  ],
  "properties": {
    "example_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "video": {"type": "string", "minLength": 1},
    "image_path": {"type": "string", "minLength": 1},
    "image_size": {"$ref": "#/$defs/nullableImageSize"},
    "caption": {"$ref": "#/$defs/caption"},
    "mention": {"$ref": "#/$defs/mention"},
    "gold_visual_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "gold_object_types": {
      "type": "array",
      "items": {"$ref": "#/$defs/objectType"},
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "objectType": {
      "enum": ["equation", "span", "term", "figure", "figure_part"]
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "nullableImageSize": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption_id", "text"],
      "properties": {
        "caption_id": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_id", "text", "span"],
      "properties": {
        "mention_id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "mention_type": {
          "enum": ["implicit", "explicit", "unknown"]
        },
        "span": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_id", "object_type", "bbox", "source"],
      "properties": {
        "visual_id": {"type": "string", "minLength": 1},
        "object_type": {"$ref": "#/$defs/objectType"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "source": {"type": "string", "minLength": 1},
        "latex": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
